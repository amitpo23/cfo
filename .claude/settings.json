{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(python scripts/production_readiness_check.py:*)",
      "Bash(python scripts/prod_smoke.py:*)",
      "Bash(python scripts/verify_sumit_writeback.py:*)",
      "Bash(python scripts/pull_sumit_item_names.py:*)",
      "Bash(python scripts/run_ocr_pipeline.py:*)",
      "Bash(python scripts/classify_expenses.py:*)",
      "Bash(python scripts/fix_prod_schema_drift.py:*)",
      "Bash(python scripts/migrate_sqlite_to_postgres.py:*)",
      "Bash(node scripts/sumit_daily_file_expenses.js:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-costly-and-generated.sh\"",
            "timeout": 10,
            "statusMessage": "בודק משמעת עלויות API"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-costly-and-generated.sh\"",
            "timeout": 10,
            "statusMessage": "בודק מסמכים מיוצרים"
          }
        ]
      }
    ]
  }
}
