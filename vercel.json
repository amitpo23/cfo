{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{.venv/**,frontend/node_modules/**,node_modules/**,.agents/**,.claude/**,tests/**,__tests__/**,**/*.test.py,**/test_*.py,*.db,*.sqlite,*.sqlite3}",
      "includeFiles": "{docs/bookkeeper_kb/**,docs/sumit_help_kb/**,docs/BOOKKEEPER_ARMY_OPERATING_MODEL.md,docs/REZEF_OPERATING_SYSTEM.md,docs/SUMIT_BOOKS_BATCH_UNIFICATION_PLAYBOOK.md}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-sumit",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/sync-open-finance",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/collection-reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/bank-gap-scan",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/bookkeeper-morning",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/channel-alerts",
      "schedule": "0 6 * * *"
    },
    {
      "schedule": "30 5 * * *",
      "path": "/api/cron/roster-health"
    }
  ]
}
