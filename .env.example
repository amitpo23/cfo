# Database Configuration
DATABASE_URL=sqlite:///./cfo.db
# For PostgreSQL: postgresql://user:password@localhost/cfo_db

# Security & JWT
JWT_SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-LONG-RANDOM-STRING-MIN-32-CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CREDENTIALS_ENCRYPTION_KEY=CHANGE-THIS-TO-A-SEPARATE-LONG-RANDOM-STRING
REGISTRATION_SECRET=CHANGE-THIS-TO-A-PRIVATE-INVITE-CODE
CRON_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-CRON-SECRET
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Keys for Accounting Systems
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REALM_ID=your_realm_id

XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret

# SUMIT API (Israeli Accounting)
SUMIT_API_KEY=your_sumit_api_key
SUMIT_COMPANY_ID=your_company_id
# Internal paid-action guardrails (0 disables the relevant scheduled work).
SUMIT_ENRICHMENT_DAILY_ACTION_LIMIT=25
OCR_LLM_ENABLED=false
OCR_DAILY_DOCUMENT_LIMIT=10
# Chat-initiated receipt intake (user sends a photo/PDF to the chat bot) —
# separate gate + daily cap from the background OCR settings above.
CHAT_RECEIPT_INTAKE_ENABLED=true
CHAT_RECEIPT_DAILY_LIMIT=20

# Open Finance API (Israeli Open Banking / Financy)
OPEN_FINANCE_CLIENT_ID=your_open_finance_client_id
OPEN_FINANCE_CLIENT_SECRET=your_open_finance_client_secret
OPEN_FINANCE_USER_ID=your_internal_user_id
OPEN_FINANCE_API_BASE_URL=https://api.open-finance.ai/v2
OPEN_FINANCE_OAUTH_URL=https://api.open-finance.ai/oauth/token
OPEN_FINANCE_WEBHOOK_SECRET=change_this_to_a_webhook_shared_secret

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# OpenAI for Financial Insights
OPENAI_API_KEY=your_openai_api_key

# Anthropic (Claude) — required for the AI chat assistant (/api/ai/chat)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Telegram conversational channel (optional, package 3 — /api/telegram/webhook)
# Bot token from @BotFather; webhook secret is your own value, registered with
# Telegram's setWebhook (secret_token param) and compared on every request.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=change_this_to_a_webhook_shared_secret

# WhatsApp conversational channel (optional, package F — Meta Cloud API,
# /api/whatsapp/webhook). One shared number for all customers, same pattern
# as SUMIT's bot. verify_token is your own value, registered in the Meta App
# dashboard's webhook subscription; app_secret authenticates every POST via
# X-Hub-Signature-256.
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_access_token
WHATSAPP_VERIFY_TOKEN=change_this_to_a_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0

# Application Settings
APP_NAME=CFO Management System
DEBUG=True
LOG_LEVEL=INFO

# Report Settings
REPORTS_OUTPUT_DIR=./reports
TIMEZONE=Asia/Jerusalem
