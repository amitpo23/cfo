# Environment Variables Configuration

# SUMIT API Configuration (Required)
SUMIT_API_KEY=your_sumit_api_key_here
SUMIT_COMPANY_ID=your_company_id_here
# Internal paid-action guardrails (0 disables the relevant scheduled work).
SUMIT_ENRICHMENT_DAILY_ACTION_LIMIT=25
OCR_LLM_ENABLED=false
OCR_DAILY_DOCUMENT_LIMIT=10
# Chat-initiated receipt intake (user sends a photo/PDF to the chat bot) —
# separate gate + daily cap from the background OCR settings above.
CHAT_RECEIPT_INTAKE_ENABLED=true
CHAT_RECEIPT_DAILY_LIMIT=20

# Database Configuration
DATABASE_URL=sqlite:///./cfo.db

# Application Settings
APP_NAME=CFO Management System
DEBUG=False
LOG_LEVEL=INFO
TIMEZONE=Asia/Jerusalem

# Security
JWT_SECRET_KEY=change_this_to_a_long_random_jwt_secret
CREDENTIALS_ENCRYPTION_KEY=change_this_to_a_separate_long_random_secret
REGISTRATION_SECRET=change_this_to_a_private_invite_code
CRON_SECRET=change_this_to_a_long_random_cron_secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OPEN_FINANCE_WEBHOOK_SECRET=change_this_to_a_webhook_shared_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Optional
OPENAI_API_KEY=your_openai_api_key_for_ai_insights

# Anthropic (Claude) — required for the AI chat assistant (/api/ai/chat)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Telegram conversational channel (optional, package 3 — /api/telegram/webhook)
# Bot token from @BotFather; webhook secret is your own value, registered with
# Telegram's setWebhook (secret_token param) and compared on every request.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=change_this_to_a_webhook_shared_secret

# WhatsApp conversational channel (optional, package F — Meta Cloud API,
# /api/whatsapp/webhook). One shared number for all customers, same pattern
# as SUMIT's bot. verify_token is your own value, registered in the Meta App
# dashboard's webhook subscription; app_secret authenticates every POST via
# X-Hub-Signature-256.
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_access_token
WHATSAPP_VERIFY_TOKEN=change_this_to_a_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0
